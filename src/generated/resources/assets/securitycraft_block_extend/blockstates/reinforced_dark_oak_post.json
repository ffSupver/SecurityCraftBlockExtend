{
  "multipart": [
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_dark_oak_post"
      },
      "when": {
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_dark_oak_post",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_dark_oak_post",
        "x": 90
      },
      "when": {
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_chain_small_quark"
      },
      "when": {
        "connect_down": "chain"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_chain_small_top_quark"
      },
      "when": {
        "connect_up": "chain"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_chain_small_top_quark",
        "x": 90
      },
      "when": {
        "connect_north": "chain"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_chain_small_quark",
        "x": 90
      },
      "when": {
        "connect_south": "chain"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_chain_small_top_quark",
        "x": 90,
        "y": 90
      },
      "when": {
        "connect_east": "chain"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_chain_small_quark",
        "x": 90,
        "y": 90
      },
      "when": {
        "connect_west": "chain"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_dark_oak_post_connect"
      },
      "when": {
        "connect_down": "other_post"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_dark_oak_post_connect_top"
      },
      "when": {
        "connect_up": "other_post"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_dark_oak_post_connect_top",
        "x": 90
      },
      "when": {
        "connect_north": "other_post"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_dark_oak_post_connect",
        "x": 90
      },
      "when": {
        "connect_south": "other_post"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_dark_oak_post_connect_top",
        "x": 90,
        "y": 90
      },
      "when": {
        "connect_east": "other_post"
      }
    },
    {
      "apply": {
        "model": "securitycraft_block_extend:block/reinforced_dark_oak_post_connect",
        "x": 90,
        "y": 90
      },
      "when": {
        "connect_west": "other_post"
      }
    }
  ]
}